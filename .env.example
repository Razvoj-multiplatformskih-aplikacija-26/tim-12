# Razvojne vrednosti — kopiraj u .env bez izmena: `cp .env.example .env`.
# Pravi .env je van repozitorijuma (.gitignore); ovde su samo vrednosti za razvoj.

# Baza (Postgres u Docker Compose-u)
DB_NAME=radioroom
DB_USER=radioroom
DB_PASSWORD=radioroom-dev
# Port baze na racunaru (5433, da ne smeta lokalnom Postgres-u na 5432).
# Server van Docker-a se povezuje na localhost:DB_PORT; u Compose-u na db:5432.
DB_HOST=localhost
DB_PORT=5433

# Server
PORT=8080
# Trajanje prijave u minutima; posle toga klijent vraca korisnika na prijavu.
SESSION_TTL_MINUTES=60

# Spoljni servis (katalog pesama) — za KT2 lazna implementacija.
SONG_CATALOG_API_KEY=fake-dev-key
